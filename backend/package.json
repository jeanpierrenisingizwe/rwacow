{
  "name": "cow-tracking-backend",
  "version": "1.0.0",
  "description": "Cow Tracking System API for Rwanda",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "mysql:migrate": "node src/database/migrate.mysql.js",
    "mysql:seed": "node src/database/seed.mysql.js",
    "mysql:add-approval": "node src/database/add-approval.mysql.js",
    "deploy:setup": "node src/database/migrate.mysql.js && node src/database/seed.mysql.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.3",
    "uuid": "^9.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
